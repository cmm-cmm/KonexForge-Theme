  "tokenColors": [
    {
      "scope": ["comment", "comment.line", "comment.block"],
      "settings": { "foreground": "#7C8494", "fontStyle": "italic" }
    },
    {
      "scope": "comment.block.documentation",
      "settings": { "foreground": "#8891A3", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#E8B168" }
    },
    {
      "scope": ["string.template", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#C97B4A" }
    },
    {
      "scope": "constant.numeric",
      "settings": { "foreground": "#D98E5A" }
    },
    {
      "scope": "constant.language",
      "settings": { "foreground": "#C97B4A", "fontStyle": "bold" }
    },
    {
      "scope": "constant.character.escape",
      "settings": { "foreground": "#FFB067" }
    },
    {
      "scope": ["keyword", "keyword.control"],
      "settings": { "foreground": "#FF7A33", "fontStyle": "italic" }
    },
    {
      "scope": "keyword.operator",
      "settings": { "foreground": "#ABB3C0" }
    },
    {
      "scope": ["storage", "storage.type"],
      "settings": { "foreground": "#D9591F" }
    },
    {
      "scope": "storage.modifier",
      "settings": { "foreground": "#D9591F", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#F5A623" }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class"],
      "settings": { "foreground": "#26C5B5" }
    },
    {
      "scope": "entity.other.inherited-class",
      "settings": { "foreground": "#26C5B5", "fontStyle": "italic" }
    },
    {
      "scope": "entity.name.tag",
      "settings": { "foreground": "#FF7A33" }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#47A8E1", "fontStyle": "italic" }
    },
    {
      "scope": ["string.quoted.double.html", "string.quoted.single.html"],
      "settings": { "foreground": "#26C5B5" }
    },
    {
      "scope": "variable",
      "settings": { "foreground": "#E4E1DC" }
    },
    {
      "scope": "variable.parameter",
      "settings": { "foreground": "#C9CDD6", "fontStyle": "italic" }
    },
    {
      "scope": ["variable.other.constant", "variable.other.readonly"],
      "settings": { "foreground": "#C97B4A", "fontStyle": "bold" }
    },
    {
      "scope": "support.type.property-name",
      "settings": { "foreground": "#47A8E1" }
    },
    {
      "scope": ["meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#8F61E5", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword.other.important", "string.regexp"],
      "settings": { "foreground": "#8F61E5" }
    },
    {
      "scope": ["punctuation", "punctuation.definition", "meta.brace"],
      "settings": { "foreground": "#ABB3C0" }
    },
    {
      "scope": "punctuation.section.embedded",
      "settings": { "foreground": "#C97B4A" }
    },
    {
      "scope": "invalid",
      "settings": { "foreground": "#1A1105", "background": "#E5484D", "fontStyle": "bold" }
    },
    {
      "scope": "markup.bold",
      "settings": { "foreground": "#E4E1DC", "fontStyle": "bold" }
    },
    {
      "scope": "markup.italic",
      "settings": { "foreground": "#E4E1DC", "fontStyle": "italic" }
    },
    {
      "scope": "markup.heading",
      "settings": { "foreground": "#FF7A33", "fontStyle": "bold" }
    },
    {
      "scope": "markup.inline.raw",
      "settings": { "foreground": "#F5A623" }
    },
    {
      "scope": "markup.underline.link",
      "settings": { "foreground": "#47A8E1", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "class": "#26C5B5",
    "interface": "#26C5B5",
    "type": "#26C5B5",
    "typeParameter": "#26C5B5",
    "struct": "#26C5B5",
    "enum": "#26C5B5",
    "function": "#F5A623",
    "method": "#F5A623",
    "event": "#8F61E5",
    "variable": "#E4E1DC",
    "parameter": { "foreground": "#C9CDD6", "fontStyle": "italic" },
    "variable.readonly": { "foreground": "#C97B4A", "fontStyle": "bold" },
    "property": "#47A8E1",
    "enumMember": "#C97B4A",
    "namespace": { "foreground": "#8F61E5", "fontStyle": "italic" },
    "decorator": { "foreground": "#8F61E5", "fontStyle": "italic" },
    "macro": { "foreground": "#FF7A33", "fontStyle": "italic" },
    "label": "#C97B4A",
    "keyword": { "foreground": "#FF7A33", "fontStyle": "italic" },
    "number": "#D98E5A",
    "string": "#E8B168",
    "operator": "#ABB3C0",
    "regexp": "#8F61E5",
    "*.defaultLibrary": { "foreground": "#47A8E1", "fontStyle": "italic" },
    "*.static": { "fontStyle": "bold" },
    "*.deprecated": { "fontStyle": "strikethrough" }
  }
}
