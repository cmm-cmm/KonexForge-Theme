  "tokenColors": [
    {
      "scope": ["comment", "comment.line", "comment.block"],
      "settings": { "foreground": "#5C5642" }
    },
    {
      "scope": "comment.block.documentation",
      "settings": { "foreground": "#433F31" }
    },
    {
      "scope": ["string", "string.quoted"],
      "settings": { "foreground": "#1B6A30" }
    },
    {
      "scope": "string.template",
      "settings": { "foreground": "#1B6A30" }
    },
    {
      "scope": "punctuation.definition.template-expression",
      "settings": { "foreground": "#5224A8" }
    },
    {
      "scope": "constant.numeric",
      "settings": { "foreground": "#0A5E85" }
    },
    {
      "scope": "constant.language",
      "settings": { "foreground": "#0A5E85", "fontStyle": "bold" }
    },
    {
      "scope": "constant.character.escape",
      "settings": { "foreground": "#5224A8" }
    },
    {
      "scope": ["keyword", "keyword.control"],
      "settings": { "foreground": "#8F3400" }
    },
    {
      "scope": "keyword.operator",
      "settings": { "foreground": "#433F31" }
    },
    {
      "scope": ["storage", "storage.type"],
      "settings": { "foreground": "#8C2E00" }
    },
    {
      "scope": "storage.modifier",
      "settings": { "foreground": "#8C2E00", "fontStyle": "bold" }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#6E4800" }
    },
    {
      "scope": ["entity.name.class", "entity.name.type", "support.class"],
      "settings": { "foreground": "#0A5241" }
    },
    {
      "scope": "entity.other.inherited-class",
      "settings": { "foreground": "#0A5241" }
    },
    {
      "scope": "entity.name.tag",
      "settings": { "foreground": "#8F3400" }
    },
    {
      "scope": "entity.other.attribute-name",
      "settings": { "foreground": "#0A5E85" }
    },
    {
      "scope": ["string.quoted.double.html", "string.quoted.single.html"],
      "settings": { "foreground": "#0A5241" }
    },
    {
      "scope": "variable",
      "settings": { "foreground": "#16150F" }
    },
    {
      "scope": "variable.parameter",
      "settings": { "foreground": "#433F31" }
    },
    {
      "scope": ["variable.other.constant", "variable.other.readonly"],
      "settings": { "foreground": "#0A5E85", "fontStyle": "bold" }
    },
    {
      "scope": "support.type.property-name",
      "settings": { "foreground": "#0A5E85" }
    },
    {
      "scope": ["meta.decorator", "punctuation.decorator"],
      "settings": { "foreground": "#5224A8" }
    },
    {
      "scope": ["keyword.other.important", "string.regexp"],
      "settings": { "foreground": "#5224A8" }
    },
    {
      "scope": ["punctuation", "punctuation.definition", "meta.brace"],
      "settings": { "foreground": "#433F31" }
    },
    {
      "scope": "punctuation.section.embedded",
      "settings": { "foreground": "#7A3E14" }
    },
    {
      "scope": "invalid",
      "settings": { "foreground": "#FFFDF8", "background": "#A3242A", "fontStyle": "bold" }
    },
    {
      "scope": "markup.bold",
      "settings": { "foreground": "#16150F", "fontStyle": "bold" }
    },
    {
      "scope": "markup.italic",
      "settings": { "foreground": "#16150F" }
    },
    {
      "scope": "markup.heading",
      "settings": { "foreground": "#8F3400", "fontStyle": "bold" }
    },
    {
      "scope": "markup.inline.raw",
      "settings": { "foreground": "#6E4800" }
    },
    {
      "scope": "markup.underline.link",
      "settings": { "foreground": "#0A5E85", "fontStyle": "underline" }
    }
  ],
  "semanticTokenColors": {
    "class": "#0A5241",
    "interface": "#0A5241",
    "type": "#0A5241",
    "typeParameter": "#0A5241",
    "struct": "#0A5241",
    "enum": "#0A5241",
    "function": "#6E4800",
    "method": "#6E4800",
    "event": "#5224A8",
    "variable": "#16150F",
    "parameter": "#433F31",
    "variable.readonly": { "foreground": "#0A5E85", "fontStyle": "bold" },
    "property": "#0A5E85",
    "enumMember": "#0A5E85",
    "namespace": "#5224A8",
    "decorator": "#5224A8",
    "macro": "#8F3400",
    "label": "#7A3E14",
    "keyword": "#8F3400",
    "number": "#0A5E85",
    "string": "#1B6A30",
    "operator": "#433F31",
    "regexp": "#5224A8",
    "*.defaultLibrary": "#0A5E85",
    "*.static": { "fontStyle": "bold" },
    "*.deprecated": { "fontStyle": "strikethrough" }
  }
}
